all: $(TARGET)

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(WIN_OBJECTS): | $(OBJDIR)

$(TARGET): $(WIN_OBJECTS)
	$(CXX) -o $@ $(WIN_OBJECTS) $(LDFLAGS) $(LIBS)

clean:
	rm -rf $(OBJDIR) $(TARGET)

.PHONY: all clean

