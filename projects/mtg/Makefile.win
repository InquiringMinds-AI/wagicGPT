# Makefile.win - Windows cross-build (mingw-w64) of the SDL2 backend.
# Mirrors Makefile.sdl's translation-unit list (the qmake Linux build is the
# reference); regenerate the WIN_OBJECTS list from Makefile.sdl if sources
# change there. Build: make -f Makefile.win -j8   (needs mingw-w64-gcc +
# mingw-w64-{sdl2,zlib,libpng,libjpeg-turbo,giflib,curl} from AUR).
CROSS   ?= x86_64-w64-mingw32-
# DEBUG=1 builds the suite-enabled dev flavor (-D_DEBUG turns on TESTSUITE
# via config.h) into its own object dir; default is the release distributable.
ifdef DEBUG
FLAVOR   = -D_DEBUG
OBJTAG   = -dbg
EXETAG   = -dbg
else
FLAVOR   =
OBJTAG   =
EXETAG   =
endif
CXX      = $(CROSS)g++
CC       = $(CROSS)gcc
SYSROOT  = /usr/x86_64-w64-mingw32
OBJDIR   = objs-win$(OBJTAG)
BINDIR   = bin

DEFINES  = $(FLAVOR) -DSDL_CONFIG -DLINUX -DNOMINMAX -D_CRT_SECURE_NO_WARNINGS \
           -DNETWORK_SUPPORT -DTIXML_USE_STL -DWITH_GPT_AI -DWIN32_CROSS
INCLUDES = -Iinclude -Iinclude/thirdparty -I../../JGE/include \
           -I../../JGE/src/zipFS -I../../Boost \
           -I$(SYSROOT)/include/SDL2 -I$(SYSROOT)/include

WARN     = -Wno-unused-parameter -Wno-unused-but-set-variable -Wno-unused-value
CXXFLAGS = -O2 -std=gnu++14 $(WARN) $(DEFINES) $(INCLUDES)
CFLAGS   = -O2 $(DEFINES) $(INCLUDES)
LDFLAGS  = -L$(SYSROOT)/lib -mwindows
LIBS     = -lmingw32 -lSDL2main -lSDL2 -lcurl -lpng -ljpeg -lgif -lz \
           -lopengl32 -lglu32 -lws2_32 -lwinmm -lgdi32 -limm32 -lole32 \
           -loleaut32 -lversion -lsetupapi -lshell32

TARGET   = $(BINDIR)/wagic$(EXETAG).exe

WIN_OBJECTS = \
	$(OBJDIR)/AbilityParser.o \
	$(OBJDIR)/ActionElement.o \
	$(OBJDIR)/ActionLayer.o \
