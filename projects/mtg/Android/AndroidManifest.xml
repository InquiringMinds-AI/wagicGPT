<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          android:versionCode="0240"
          android:installLocation="preferExternal"
          android:versionName="@string/app_version"
          package="net.wagic.app">
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Manual Res placement lives at <storage>/Wagic/Res; scoped storage would
       lock a target-29 app out of that path on Android 10+ without this. -->
  <!-- The LLM opponent talks to an endpoint the USER names, and the common
       cases are plain-HTTP local inference (a llama.cpp or Ollama box on the
       LAN). Android blocks cleartext by default from target 28 on, which would
       fail those before a packet left the device - and the GPT layer reads any
       transport failure as "endpoint unreachable" and silently falls back to
       the heuristic AI. HTTPS endpoints are unaffected by this flag. -->
  <application android:icon="@drawable/icon"
               android:label="@string/app_name"
               android:requestLegacyExternalStorage="true"
               android:usesCleartextTraffic="true"
               android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
               
    <activity android:debuggable="false"
              android:configChanges="keyboard|keyboardHidden|orientation"
              android:label="@string/app_name"
              android:name="org.libsdl.app.SDLActivity"
              android:screenOrientation="sensorLandscape">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
  <uses-sdk android:minSdkVersion="10"
            android:targetSdkVersion="29" />
</manifest>
